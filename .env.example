# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/seeknpurchase

# Long random string (min 32 chars) used to sign session tokens
AUTH_SECRET=

# Stripe (leave blank to run checkout in "manual payment" mode)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `npm run seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
